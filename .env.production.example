# 在部署目录复制为 .env，使用随机密码，并同步修改 DATABASE_URL 中的密码。
# DATABASE_URL 中有特殊字符的密码需 URL 编码；使用随机十六进制密码可避免编码问题。
POSTGRES_DB=yu
POSTGRES_USER=yu
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql://yu:replace_with_random_password@db:5432/yu
APP_HOST=book.example.com
APP_ORIGIN=https://book.example.com
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=yu
OIDC_CLIENT_SECRET=
# 填写部署环境中已配置的 Traefik 证书解析器名称。
TRAEFIK_CERT_RESOLVER=replace_with_resolver_name
# 应用和迁移镜像应来自同一提交或版本，自动更新端应固定为 digest。
YU_APP_IMAGE=ghcr.io/662/yu:edge
YU_MIGRATOR_IMAGE=ghcr.io/662/yu-migrator:edge
YU_POSTGRES_IMAGE=postgres:18
# PostgreSQL 18 挂载父目录；已有命名卷部署需停库迁移后再切换。
YU_POSTGRES_DIR=./postgres
