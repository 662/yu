{
  "name": "yu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml down",
    "test": "tsx --test src/features/book/*.test.ts src/features/import/*.test.ts src/lib/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:backup && pnpm build",
    "test:integration": "bash scripts/test-integration.sh",
    "bench": "tsx scripts/bench-book.ts",
    "backup": "bash scripts/backup.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "backup:schedule": "python3 scripts/install-backup-cron.py",
    "test:backup": "python3 -m unittest discover -s scripts -p test_backup.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  }
}
