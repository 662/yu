# 复制为 .env.backup；这是 Bash 配置文件，路径包含空格时需要引号。
YU_DOCKER_CONTEXT=${YU_DOCKER_CONTEXT:-nas}
YU_ENV_FILE=${YU_ENV_FILE:-.env.nas}
YU_BACKUP_RETENTION_DAYS=${YU_BACKUP_RETENTION_DAYS:-30}
# weekly：周日备份后执行隔离恢复；true：每次恢复验证；false：仅校验归档。
YU_VERIFY_BACKUP=${YU_VERIFY_BACKUP:-weekly}
# 默认写到本机项目的 .backups，与 NAS 数据盘分离；可改为独立备份盘。
# YU_BACKUP_DIR=/path/to/backups
